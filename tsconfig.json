{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src",
    "components",
    "hooks",
    "lib",
    ".astro/types.d.ts",
    "emdash-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
